{
  "name": "Brain Snapshot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "schedule-brain",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "command": "sh /volume2/projects/github_brain_ridge/brain-snapshot.sh"
      },
      "id": "ssh-brain",
      "name": "Run brain-snapshot",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "sshPrivateKey": {
          "id": "nas-deploy",
          "name": "NAS Deploy"
        }
      }
    }
  ],
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "Run brain-snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
